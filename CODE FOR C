struct Row {
    int id;
    int lb;
    int rb;
    int mb;
};

int maxNumberOfFamilies(int n, int** r_seats, int r_size, int* r_col) {
    struct Row arr[10005];
    int count = 0;
    
    for (int i = 0; i < r_size; i++) {
        int x = r_seats[i][0];
        int y = r_seats[i][1];
        
        int idx = -1;
        for (int j = 0; j < count; j++) {
            if (arr[j].id == x) {
                idx = j;
                break;
            }
        }
        
        if (idx == -1) {
            arr[count].id = x;
            arr[count].lb = 0;
            arr[count].rb = 0;
            arr[count].mb = 0;
            idx = count;
            count++;
        }
        
        if (y == 2 || y == 3) {
            arr[idx].lb = 1;
        } else if (y == 4 || y == 5) {
            arr[idx].lb = 1;
            arr[idx].mb = 1;
        } else if (y == 6 || y == 7) {
            arr[idx].rb = 1;
            arr[idx].mb = 1;
        } else if (y == 8 || y == 9) {
            arr[idx].rb = 1;
        }
    }
    
    long long ans = (long long)(n - count) * 2;
    
    for (int i = 0; i < count; i++) {
        int lf = (arr[i].lb == 0);
        int rf = (arr[i].rb == 0);
        int mf = (arr[i].mb == 0);
        
        if (lf && rf) {
            ans = ans + 2;
        } else if (lf || rf || mf) {
            ans = ans + 1;
        }
    }
    
    return ans;
}
